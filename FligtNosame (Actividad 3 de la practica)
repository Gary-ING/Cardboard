using UnityEngine;
using System.Collections.Generic;
using UnityEngine.InputSystem;
using System.Threading;
using Unity.VisualScripting;
using System.IO;

public class FligtNosame : MonoBehaviour
{
//Variable de clase
public float speed = 50f;
public float rotationSpeed = 100;
public Transform cameraTransform;
public Vector2 movementInput;

//Control de iteraciones
public int turbulenceIterations = 1000000;

//Lista de vectores de posicion calculados
private List<Vector3> turbulenceForces = new();

//Lista de vectores de posicion el hilo secundario
private Thread turbulenceThread;
private bool isTurbulenceRunnig = false;
private bool stopTurbulenceThread = false;
private float captureTime; // CORRECCIÓN 1: Cambiado a float

//Bandera de control sobre lectura
public bool real = false;
string filepath;



public void OnMovement(InputValue value)
{
    movementInput = value.Get<Vector2>();
}

// Start is called once before the first execution of Update after the MonoBehaviour is created
void Start()
{
    filepath = Application.dataPath + "/TurbulenceData.txt";
    Debug.Log("Ruta al archivo:" + filepath);


}

// Update is called once per frame
void Update()
{
    if (cameraTransform == null)
    {
        Debug.LogError("No hay camara asignada");
        return;

    }

    //Tiempo transcurrido
    captureTime = Time.time;
    if (!isTurbulenceRunnig)
    {
        isTurbulenceRunnig = true;
        stopTurbulenceThread = false;
        // CORRECCIÓN 2: Se agregó 'captureTime' como parámetro
        turbulenceThread = new Thread(() => SimulateTurbulence(captureTime));
        turbulenceThread.Start();
    }
    //Proceso de consumo de recursos
    SimulateTurbulence(captureTime); // CORRECCIÓN 2: Se agregó 'captureTime'

    //Mover la nave linearmente
    Vector3 moveDirection = cameraTransform.forward * movementInput.y * speed * Time.deltaTime;
    this.transform.position += moveDirection;
    //Mover la nave en rotacion
    float yaw = movementInput.x * rotationSpeed * Time.deltaTime;
    this.transform.Rotate(0, yaw, 0);

    //Metodo para lectura
    TryReadFile();



}
public void SimulateTurbulence(float time)
{
    turbulenceForces.Clear();

    //Repeteciones
    for (int i = 0; i < turbulenceIterations; i++)
    { // CORRECCIÓN 3: Llave de apertura del for agregada aquí
        if (stopTurbulenceThread)
        {
            break;
        }

        Vector3 force = new Vector3(
            Mathf.PerlinNoise(i * 0.001f, time) * 2 - 1,
            Mathf.PerlinNoise(i * 0.002f, time) * 2 - 1,
             Mathf.PerlinNoise(i * 0.003f, time) * 2 - 1
            );
        turbulenceForces.Add(force);

    } // CORRECCIÓN 3: Llave de cierre englobando todo

    //Señal en consola de incio de hilo
    Debug.Log("Iniciando simulaciones de turbulencias");
    //Escritura del archivo
    // CORRECCIÓN 4 (Actual): Cambiado 'weiter' por 'writer'
    using (StreamWriter writer = new StreamWriter(filepath, false))
    {
        foreach (var force in turbulenceForces)
        {
            writer.WriteLine(force.ToString());
        }
        writer.Flush();
    }
    Debug.Log("Archivo escrito");




    isTurbulenceRunnig = false;
}
public void TryReadFile()
{
    try
    {
        // CORRECCIÓN 5 (Actual): Cambiado 'contet' por 'content'
        string content = File.ReadAllText(filepath);
        Debug.Log("Archivo leido" + content);
    }
    catch (IOException ex)
    {
        Debug.LogError("Error en acceso al archivo: " + ex.Message);
    }
} // CORRECCIÓN 6 (Actual): Faltaba esta llave de cierre para el método TryReadFile

private void OnDestroy()
{
    //Indicar el cierre del hilo secundario
    stopTurbulenceThread = true;
    if (turbulenceThread != null && turbulenceThread.IsAlive)
    {
        turbulenceThread.Join();
    }
}
}
